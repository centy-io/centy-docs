{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(pnpm run build:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(centy create issue:*)",
      "Bash(git push:*)",
      "Bash(command -v:*)",
      "Bash(centy show:*)",
      "Bash(centy list:*)",
      "Bash(centy --help:*)",
      "Bash(git checkout:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm install:*)",
      "Bash(centy update:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": ["Bash(gh issue create:*)"],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx block-no-verify"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op read"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      }
    ]
  }
}
